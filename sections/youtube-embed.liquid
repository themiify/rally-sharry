{% assign is_rtl = request.is_rtl %}
{% assign username = section.settings.username | default: '' | strip | remove: '@' %}
{% assign heading = section.settings.heading | default: 'Watch us on YouTube' %}
{% assign heading_ar = section.settings.heading_ar | default: 'شاهدي محتوى متجرنا على يوتيوب' %}
{% assign display_heading = heading %}
{% if is_rtl %}
  {% assign display_heading = heading_ar | default: heading %}
{% endif %}
{% assign encoded_username = username | url_encode %}
{% capture profile_url %}https://www.youtube.com/@{{ encoded_username }}{% endcapture %}
{% capture embed_url %}https://www.youtube.com/embed?listType=user_uploads&list={{ encoded_username }}&rel=0&playsinline=1{% endcapture %}

<section id="social-embed-{{ section.id }}" class="gl-section gl-social-embed-section gl-social-embed-section--youtube" aria-labelledby="social-embed-heading-{{ section.id }}">
  <div class="gl-container">
    <div class="gl-social-embed-card">
      <div class="gl-section-header gl-social-embed-header">
        <p class="gl-social-embed-eyebrow">YouTube</p>
        <h2 id="social-embed-heading-{{ section.id }}">{{ display_heading | escape }}</h2>
        {% if username != blank %}
          <a class="gl-social-embed-profile-link" href="{{ profile_url | escape }}" target="_blank" rel="noopener noreferrer">@{{ username | escape }}</a>
        {% endif %}
      </div>

      {% if username != blank %}
        <div class="gl-social-embed-frame gl-social-embed-frame--youtube">
          <iframe src="{{ embed_url | escape }}" title="{{ display_heading | escape }}" loading="lazy" referrerpolicy="strict-origin-when-cross-origin" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>
        </div>
      {% else %}
        <div class="gl-social-embed-empty">
          <p>{{ translations.social_embeds.configure | default: 'Add a username in this section settings to display the social profile.' | escape }}</p>
        </div>
      {% endif %}
    </div>
  </div>
</section>
