{% assign is_rtl = request.is_rtl %}
{% assign username = section.settings.username | default: '' | strip | remove: '@' %}
{% assign heading = section.settings.heading | default: 'Follow us on TikTok' %}
{% assign heading_ar = section.settings.heading_ar | default: 'تابعينا على تيك توك' %}
{% assign display_heading = heading %}
{% if is_rtl %}
  {% assign display_heading = heading_ar | default: heading %}
{% endif %}
{% assign encoded_username = username | url_encode %}
{% capture profile_url %}https://www.tiktok.com/@{{ encoded_username }}{% endcapture %}

<section id="social-embed-{{ section.id }}" class="gl-section gl-social-embed-section gl-social-embed-section--tiktok" aria-labelledby="social-embed-heading-{{ section.id }}">
  <div class="gl-container">
    <div class="gl-social-embed-card">
      <div class="gl-section-header gl-social-embed-header">
        <p class="gl-social-embed-eyebrow">TikTok</p>
        <h2 id="social-embed-heading-{{ section.id }}">{{ display_heading | escape }}</h2>
        {% if username != blank %}
          <a class="gl-social-embed-profile-link" href="{{ profile_url | escape }}" target="_blank" rel="noopener noreferrer">@{{ username | escape }}</a>
        {% endif %}
      </div>

      {% if username != blank %}
        <div class="gl-social-embed-frame gl-social-embed-frame--tiktok" data-social-embed="tiktok">
          <blockquote class="tiktok-embed" cite="{{ profile_url | escape }}" data-unique-id="{{ username | escape }}" data-embed-type="creator" data-embed-from="oembed">
            <section><a target="_blank" rel="noopener noreferrer" href="{{ profile_url | escape }}">@{{ username | escape }}</a></section>
          </blockquote>
        </div>
      {% else %}
        <div class="gl-social-embed-empty">
          <p>{{ translations.social_embeds.configure | default: 'Add a username in this section settings to display the social profile.' | escape }}</p>
        </div>
      {% endif %}
    </div>
  </div>
</section>
