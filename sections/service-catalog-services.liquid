<section class="gl-section service-catalog-section service-catalog-services" data-service-catalog-surface="services">
  <div class="gl-container">
    {% if section.settings.show_profile != false and service_catalog.profile.name != blank %}
      <header class="service-catalog-heading">
        <p class="service-catalog-eyebrow">{{ 'service_catalog.services.eyebrow' | t }}</p>
        <h1>{{ service_catalog.profile.services_title | default: service_catalog.profile.name }}</h1>
        {% if service_catalog.profile.services_intro != blank %}<p>{{ service_catalog.profile.services_intro }}</p>{% endif %}
      </header>
    {% endif %}

    {% if section.settings.show_story != false %}
      {% if service_catalog.profile.services_story_title != blank or service_catalog.profile.services_story_body != blank or service_catalog.profile.services_story_image != blank %}
        <div class="service-catalog-story">
          <div class="service-catalog-story__content">
            {% if service_catalog.profile.services_story_title != blank %}<h2>{{ service_catalog.profile.services_story_title }}</h2>{% endif %}
            {% if service_catalog.profile.services_story_body != blank %}<div class="service-catalog-story__body">{{ service_catalog.profile.services_story_body | newline_to_br }}</div>{% endif %}
          </div>
          {% if service_catalog.profile.services_story_image != blank %}<img src="{{ service_catalog.profile.services_story_image }}" alt="{{ service_catalog.profile.services_story_title | default: service_catalog.profile.services_title }}" loading="lazy">{% endif %}
        </div>
      {% endif %}
    {% endif %}

    {% if service_catalog.services.size > 0 %}
      <div class="service-catalog-grid service-catalog-grid--{{ section.settings.columns }}">
        {% for service in service_catalog.services %}
          {% render 'service-catalog-service-card', service: service, show_images: section.settings.show_images %}
        {% endfor %}
      </div>
    {% else %}
      <p class="service-catalog-empty">{{ 'service_catalog.services.empty' | t }}</p>
    {% endif %}
  </div>
</section>

{% schema %}
{
    "name": {
        "en": "Services Listing",
        "ar": "قائمة الخدمات"
    },
    "category": "service-catalog",
    "reusable": true,
    "settings": [
        {
            "type": "checkbox",
            "id": "show_profile",
            "label": "Show provider intro",
            "label_ar": "إظهار مقدمة مقدم الخدمة",
            "default": true
        },
        {
            "type": "checkbox",
            "id": "show_story",
            "label": "Show services story",
            "label_ar": "إظهار قصة الخدمات",
            "default": true
        },
        {
            "type": "checkbox",
            "id": "show_images",
            "label": "Show service images",
            "label_ar": "إظهار صور الخدمات",
            "default": true
        },
        {
            "type": "select",
            "id": "columns",
            "label": "Columns",
            "label_ar": "الأعمدة",
            "default": "3",
            "options": [
                {
                    "value": "2",
                    "label": "Two",
                    "label_ar": "اثنان"
                },
                {
                    "value": "3",
                    "label": "Three",
                    "label_ar": "ثلاثة"
                },
                {
                    "value": "4",
                    "label": "Four",
                    "label_ar": "أربعة"
                }
            ]
        }
    ],
    "defaults": {
        "show_profile": true,
        "show_story": true,
        "show_images": true,
        "columns": "3"
    }
}
{% endschema %}
