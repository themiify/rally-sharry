{% comment %}
  Partial: one service card. Not a section (no schema) — rendered with
  {% render 'service-catalog-service-card', service: service %}.

  Params:
    service        ServiceCard (name, url, image, excerpt)
    show_images    false hides the image (default: shown)
    heading_level  2-4, so the card title nests under the surrounding headings (default: 2)
    priority       true loads the image eagerly (use for the first, above-the-fold cards)
{% endcomment %}
{% assign card_level = heading_level | default: 2 %}
<article class="service-catalog-card">
  {% if show_images != false and service.image != blank %}<img src="{{ service.image }}" alt="{{ service.name }}" width="640" height="480" loading="{% if priority == true %}eager{% else %}lazy{% endif %}" decoding="async">{% endif %}
  <div class="service-catalog-card__body">
    <h{{ card_level }} class="service-catalog-card__title"><a href="{{ service.url }}">{{ service.name }}</a></h{{ card_level }}>
    {% if service.excerpt != blank %}<p class="service-catalog-card__excerpt">{{ service.excerpt }}</p>{% endif %}
    <a class="service-catalog-link" href="{{ service.url }}">{{ 'service_catalog.services.view' | t }}</a>
  </div>
</article>
